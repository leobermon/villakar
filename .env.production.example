# Variables de PRODUCCIÓN (VPS). En el servidor: cp .env.production.example .env
# y llena los valores. Ese .env NUNCA se sube a git.
# Para generar contraseñas y secretos:  openssl rand -hex 32

# Hace que `docker compose` use el archivo de producción sin escribir -f.
COMPOSE_FILE=docker-compose.prod.yml

# ---- Dominio ----
# Sitio: https://DOMAIN   Panel: https://admin.DOMAIN   (www.DOMAIN redirige al sitio)
DOMAIN=villakarshuttle.com
# Correo para avisos de Let's Encrypt (certificados HTTPS).
ACME_EMAIL=reservations@villakarshuttle.com

# ---- Base de datos (MySQL 8 dentro de Docker) ----
MYSQL_DATABASE=villakar
MYSQL_USER=villakar
# Solo letras y números (van dentro de una URL de conexión). Usa: openssl rand -hex 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
BACKUP_KEEP_DAYS=14

# ---- Google Maps (búsqueda de hoteles) ----
# Clave de servidor (Places API New). En Google Cloud, restríngela a la IP del VPS.
GOOGLE_MAPS_SERVER_KEY=
PLACES_CACHE_DAYS=30

# ---- Reservas ----
# Valores iniciales; después se cambian desde el panel (Configuración).
BOOKING_MIN_NOTICE_HOURS=12
BOOKING_HOLD_MINUTES=60
CASH_PAYMENTS_ENABLED=true

# ---- Correo (Hostinger) ----
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=reservations@villakarshuttle.com
# La contraseña de ese buzón (la que pusiste al crearlo en hPanel → Correos).
SMTP_PASS=
MAIL_FROM="VillaKar Transfers <reservations@villakarshuttle.com>"

# ---- Panel de administración ----
# Secreto largo y aleatorio: openssl rand -hex 48
ADMIN_JWT_SECRET=
ADMIN_SESSION_HOURS=12
# Primer usuario del panel (se crea una sola vez; ver deploy/README.md).
# Después de crearlo, borra ADMIN_SEED_PASSWORD de este archivo.
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_PASSWORD=

# ---- Pagos en línea (opcionales; vacíos = el sitio no los ofrece) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
