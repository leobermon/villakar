# Copiar a .env y completar.
DATABASE_URL="mysql://transfers:transfers@localhost:3306/cancun_transfers"
PORT=3000

# Clave de Google Maps Platform SOLO para el servidor (Places API New).
# Restringirla por IP del servidor; nunca exponerla en el frontend.
GOOGLE_MAPS_SERVER_KEY=

# Orígenes permitidos (sitio público y panel admin), separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Días que se reutilizan las coordenadas de un hotel antes de refrescarlas con Google.
PLACES_CACHE_DAYS=30

# URL pública del sitio de reservas (regreso desde Stripe / PayPal).
PUBLIC_SITE_URL=http://localhost:5173
# Anticipación mínima (horas) y minutos que se aparta el precio de una reserva sin pagar.
BOOKING_MIN_NOTICE_HOURS=12
BOOKING_HOLD_MINUTES=60

# Stripe (claves de prueba sk_test_... en desarrollo). El secreto del webhook
# (whsec_...) lo da `stripe listen` o el panel de Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal REST (app de sandbox en developer.paypal.com). PAYPAL_ENV: sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Pago en efectivo al chofer después del servicio (true / false).
CASH_PAYMENTS_ENABLED=true
