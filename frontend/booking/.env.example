# URL base del backend. En desarrollo se usa el proxy de Vite (/api).
VITE_API_URL=/api
# Google Analytics 4. Déjalo vacío en desarrollo para no ensuciar los datos; en producción va en el build.
VITE_GA_ID=
# Google Tag Manager (solo producción). Si no se define, usa el contenedor del sitio.
VITE_GTM_ID=
